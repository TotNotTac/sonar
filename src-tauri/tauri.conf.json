{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sonar",
  "version": "0.1.0",
  "identifier": "dev.sonar.filemanager",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Sonar",
        "width": 1100,
        "height": 700,
        "minWidth": 640,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "linux": {
      "deb": { "depends": [] }
    }
  }
}
